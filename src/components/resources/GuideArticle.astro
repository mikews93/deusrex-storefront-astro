---
/**
 * A gancho guide inside the clinic's site (deusrex#2352). The same blocks as
 * the directory page (deusrex landing `PostGuide.astro`), drawn in the site's
 * own design system — `--ai-*` — so it reads as a page of the clinic, not as
 * a page of DeusRex. Booking goes to the site's own /book.
 */
import type { GuideStepIcon, SiteResource, SiteResources } from '../../lib/resources';

interface Props {
  resource: SiteResource;
  author: SiteResources['author'];
  businessName: string;
}

const { resource, author, businessName } = Astro.props;
const { content } = resource;

/** The title with its highlight set apart; the backend checked it is inside. */
const at = content.highlight ? content.title.indexOf(content.highlight) : -1;
const [before, highlight, after] =
  at >= 0
    ? [content.title.slice(0, at), content.highlight, content.title.slice(at + content.highlight.length)]
    : [content.title, '', ''];

const anchorOf = (index: number) => `seccion-${index + 1}`;
const paragraphs = (text: string) => text.split(/\n+/).filter(Boolean);

const icons: Record<GuideStepIcon, string> = {
  chat: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2',
  book: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
  home: 'M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
  heart: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z',
  play: 'M6 4l14 8-14 8z',
  check: 'M20 6 9 17l-5-5',
  calendar: 'M4 5h16v16H4zM16 3v4M8 3v4M4 10h16',
};
---

<article class="gd" data-guide>
  <header class="gd-cover">
    <div class="sf-container gd-cover-inner">
      <a class="gd-back" href="/recursos">← Recursos</a>
      <span class="gd-badge">Guía gratuita</span>
      <h1 class="gd-title">{before}{highlight && <em>{highlight}</em>}{after}</h1>
      {content.intro && <p class="gd-intro">{content.intro}</p>}
      <p class="gd-meta">
        <span>{content.blocks.length} secciones</span>
        <span>Lectura de {resource.readingMinutes} min</span>
      </p>
    </div>
  </header>

  <nav aria-label="En esta guía" class="gd-index">
    <div class="sf-container gd-index-inner">
      <span class="gd-index-label">En esta guía</span>
      {content.blocks.map((block, index) => (
        <a href={`#${anchorOf(index)}`}>
          {block.kicker || (block.type === 'myth_fact' ? 'Un mito' : block.heading)}
        </a>
      ))}
    </div>
  </nav>

  <div class="sf-container gd-body">
    <div class="gd-blocks">
      {content.blocks.map((block, index) => (
        <section id={anchorOf(index)} class="gd-block">
          {block.kicker && <span class="gd-kicker">{block.kicker}</span>}
          {'heading' in block && block.heading && <h2 class="gd-heading">{block.heading}</h2>}

          {block.type === 'text' && paragraphs(block.body).map((p) => <p class="gd-text">{p}</p>)}

          {block.type === 'stat' && (
            <div class="gd-stat">
              <div class="gd-stat-value">
                {block.value}
                {block.unit && <small>{block.unit}</small>}
              </div>
              <p>{block.body}</p>
            </div>
          )}

          {block.type === 'checklist' && (
            <div data-checklist data-threshold={block.threshold} data-few={block.adviceFew} data-many={block.adviceMany}>
              <div class="gd-checklist">
                {block.items.map((item) => (
                  <label>
                    <input type="checkbox" />
                    <span>{item.text}</span>
                    {item.note && <span class="gd-note">{item.note}</span>}
                  </label>
                ))}
              </div>
              <p data-advice aria-live="polite" class="gd-advice">Marca las que reconoces.</p>
            </div>
          )}

          {block.type === 'steps' && (
            <ol class="gd-steps">
              {block.items.map((item) => (
                <li>
                  <span class="gd-step-icon">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[item.icon]} /></svg>
                  </span>
                  <span><b>{item.title}</b><span>{item.body}</span></span>
                </li>
              ))}
            </ol>
          )}

          {block.type === 'myth_fact' && (
            <div class="gd-myth">
              <div><span class="gd-myth-label">Mito</span><p>{block.myth}</p></div>
              <div><span class="gd-fact-label">Realidad</span><p>{block.fact}</p></div>
            </div>
          )}

          {block.type === 'consult' && (
            <div class="gd-consult">
              {paragraphs(block.body).map((p) => <p>{p}</p>)}
            </div>
          )}
        </section>
      ))}
    </div>

    <aside class="gd-aside">
      <div class="gd-card">
        <b>{author?.name ?? businessName}</b>
        <span class="gd-card-sub">{author ? [author.specialty, businessName].filter(Boolean).join(' · ') : 'Nuestro equipo'}</span>
        <a class="gd-button" href="/book">{content.ctaLabel}</a>
      </div>
    </aside>
  </div>

  <p class="sf-container gd-disclaimer">Información educativa. No reemplaza una valoración profesional.</p>
</article>

<style>
  .gd {
    --gd-line: color-mix(in srgb, var(--ai-text) 12%, transparent);
    --gd-soft: color-mix(in srgb, var(--ai-primary) 10%, var(--ai-surface));
    color: var(--ai-text);
    margin-top: -2rem;
  }
  .gd-cover {
    background: color-mix(in srgb, var(--ai-primary) 82%, #0c1512);
    color: #fff;
  }
  .gd-cover-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .gd-back {
    color: inherit;
    opacity: 0.85;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .gd-back:hover { text-decoration: underline; }
  .gd-badge {
    width: max-content;
    padding: 0.25rem 0.625rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.15);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .gd-title {
    margin: 0;
    max-width: 22ch;
    font-family: var(--ai-heading-font);
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .gd-title em { opacity: 0.8; }
  .gd-intro { margin: 0; max-width: 52ch; font-size: 1.0625rem; opacity: 0.92; }
  .gd-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0; font-size: 0.8rem; opacity: 0.8; }

  .gd-index {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--gd-line);
    background: color-mix(in srgb, var(--ai-bg) 94%, transparent);
    backdrop-filter: blur(8px);
  }
  .gd-index-inner { display: flex; align-items: center; gap: 0.5rem; overflow-x: auto; padding-top: 0.75rem; padding-bottom: 0.75rem; }
  .gd-index-label { flex: none; font-size: 0.75rem; font-weight: 700; color: var(--ai-text-muted); }
  .gd-index a {
    flex: none;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--gd-line);
    border-radius: 999px;
    background: var(--ai-surface);
    color: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .gd-index a:hover { border-color: var(--ai-primary); color: var(--ai-primary); }

  .gd-body { display: grid; gap: 2rem; padding-top: 2rem; padding-bottom: 2rem; }
  @media (min-width: 768px) {
    .gd-body { grid-template-columns: minmax(0, 1fr) 270px; align-items: start; }
    .gd-aside { position: sticky; top: 4.5rem; }
  }
  .gd-blocks { display: flex; flex-direction: column; gap: 2.25rem; min-width: 0; }
  .gd-block { scroll-margin-top: 5rem; }
  .gd-kicker { display: block; margin-bottom: 0.375rem; font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ai-primary); }
  .gd-heading { margin: 0 0 0.75rem; font-family: var(--ai-heading-font); font-size: 1.5rem; line-height: 1.2; text-wrap: balance; }
  .gd-text { margin: 0 0 0.75rem; max-width: 62ch; line-height: 1.7; }

  .gd-stat { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 1.25rem; padding: 1.25rem; border-radius: var(--ai-radius); background: var(--gd-soft); }
  .gd-stat-value { font-family: var(--ai-heading-font); font-size: 3.5rem; line-height: 0.9; color: var(--ai-primary); }
  .gd-stat-value small { display: block; margin-top: 0.375rem; font-family: var(--ai-font); font-size: 0.875rem; font-weight: 700; color: var(--ai-text-muted); }
  .gd-stat p { margin: 0; line-height: 1.6; }

  .gd-checklist { overflow: hidden; border: 1px solid var(--gd-line); border-radius: var(--ai-radius); }
  .gd-checklist label { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem 1rem; border-top: 1px solid var(--gd-line); cursor: pointer; }
  .gd-checklist label:first-child { border-top: 0; }
  .gd-checklist input { margin-top: 0.2rem; accent-color: var(--ai-primary); width: 1.1rem; height: 1.1rem; flex: none; }
  .gd-note { margin-left: auto; padding-left: 0.5rem; font-size: 0.75rem; color: var(--ai-text-muted); white-space: nowrap; }
  .gd-advice { margin: 0.5rem 0 0; min-height: 1.25rem; font-size: 0.85rem; color: var(--ai-text-muted); }

  .gd-steps { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .gd-steps li { display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem; border: 1px solid var(--gd-line); border-radius: var(--ai-radius); background: var(--ai-surface); }
  .gd-steps li > span:last-child { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.875rem; }
  .gd-step-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 999px; background: var(--gd-soft); color: var(--ai-primary); }

  .gd-myth { display: grid; overflow: hidden; border: 1px solid var(--gd-line); border-radius: var(--ai-radius); }
  @media (min-width: 640px) { .gd-myth { grid-template-columns: 1fr 1fr; } }
  .gd-myth > div { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem; }
  .gd-myth > div:first-child { background: color-mix(in srgb, #b45309 8%, var(--ai-surface)); }
  .gd-myth > div:last-child { background: color-mix(in srgb, #15803d 8%, var(--ai-surface)); }
  .gd-myth p { margin: 0; }
  .gd-myth-label, .gd-fact-label { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .gd-myth-label { color: #b42318; }
  .gd-fact-label { color: #15803d; }

  .gd-consult { padding: 1rem; border: 1px solid color-mix(in srgb, #b45309 30%, transparent); border-radius: var(--ai-radius); background: color-mix(in srgb, #b45309 7%, var(--ai-surface)); }
  .gd-consult p { margin: 0 0 0.5rem; line-height: 1.6; }
  .gd-consult p:last-child { margin-bottom: 0; }

  .gd-card { display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem; border: 1px solid var(--gd-line); border-radius: var(--ai-radius); background: var(--ai-surface); }
  .gd-card-sub { font-size: 0.8rem; color: var(--ai-text-muted); }
  .gd-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--ai-radius);
    background: var(--ai-primary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .gd-button:hover { opacity: 0.9; }
  .gd-disclaimer { padding-bottom: 1rem; font-size: 0.75rem; color: var(--ai-text-muted); }

  @media (prefers-reduced-motion: reduce) {
    .gd-index a, .gd-button { transition: none; }
  }
</style>

<script>
  // The list a reader ticks answers back, as on the directory page.
  document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((list) => {
    const threshold = Number(list.dataset.threshold) || 2;
    const advice = list.querySelector<HTMLElement>('[data-advice]');
    const boxes = list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    const update = () => {
      if (!advice) return;
      const ticked = [...boxes].filter((b) => b.checked).length;
      advice.textContent =
        ticked === 0
          ? 'Marca las que reconoces.'
          : `Marcaste ${ticked}. ${ticked >= threshold ? list.dataset.many : list.dataset.few}`;
    };
    boxes.forEach((box) => box.addEventListener('change', update));
  });
</script>
