---
/**
 * Courses list — static shell; fetches courses client-side. Spec 004 FR-003.
 */
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import CatalogList from '../../islands/CatalogList.tsx';
import i18n from '../../i18n';
---

<SubPageLayout title={i18n.t('storefront.nav.courses')}>
  <div class="sf-container">
    <h1 class="sf-page-title">{i18n.t('storefront.nav.courses')}</h1>
    <CatalogList
      client:load
      section="courses"
      detailPathBase="/courses"
      emptyState={{
        title: i18n.t('storefront.pages.emptyCourses.title'),
        description: i18n.t('storefront.pages.emptyCourses.description'),
      }}
    />
  </div>
</SubPageLayout>
