---
/**
 * Services list — static shell, fetches catalog client-side at runtime.
 * Spec 004 FR-003 / FR-003a: build is catalog-independent; the page itself
 * always returns 200 and the island handles loading/empty/error UI.
 */
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import CatalogList from '../../islands/CatalogList.tsx';
import i18n from '../../i18n';
---

<SubPageLayout title={i18n.t('storefront.nav.services')}>
  <div class="sf-container">
    <h1 class="sf-page-title">{i18n.t('storefront.nav.services')}</h1>
    <CatalogList
      client:load
      section="services"
      detailPathBase="/services"
      emptyState={{
        title: i18n.t('storefront.pages.emptyServices.title'),
        description: i18n.t('storefront.pages.emptyServices.description'),
      }}
    />
  </div>
</SubPageLayout>
