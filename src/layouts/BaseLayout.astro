---
/**
 * BaseLayout — wraps all pages with <head> (SEO, JSON-LD, fonts, CSS vars)
 * and global UI elements (cart provider, chat widget).
 *
 * Props injected by AstroSiteGeneratorService at build time:
 * - siteData is imported from a generated data module
 */
import '../styles/global.css';
import '../styles/storefront.css';
import { ORG_SLUG, PUBLIC_API_BASE_URL } from '../runtime/public-api-config';

interface Props {
  title?: string;
  description?: string;
  /** `article` on a /recursos guide (deusrex#2352); `website` elsewhere. */
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;

// Site data injected at build time
const siteData = await import('../data/site-data.json');
const { business, website, designSystem } = siteData.default || siteData;

const pageTitle = title
  ? `${title} | ${business.name}`
  : website.seoTitle || business.name;
const pageDescription = description || website.seoDescription || business.description || '';
const siteUrl = Astro.site?.toString() || '';
// `build.format: 'file'` makes Astro.url.pathname the emitted object name
// (/services.html), but every link on the site — and so every URL a crawler
// reaches — is the extensionless one. Declaring the .html twin as canonical
// would split the signal across two URLs serving identical content.
const canonicalPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
// JSON-LD carries the structured-data OBJECT, never markup. This layout owns
// the <script> tag, so the value can never introduce an element of its own.
// Escaping `</` is what keeps a string value inside the tag it belongs to;
// `\/` is a valid JSON escape for `/`, so the payload still parses. Same
// treatment as the SSR renderer's document shell, which builds this tag too.
const jsonLd =
  typeof website.jsonLd === 'string' ? website.jsonLd.replace(/<\//g, '<\\/') : '';
const fontFamily = designSystem?.fontFamily || website.fontFamily || 'Inter';
const headingFontFamily = designSystem?.headingFontFamily || fontFamily;
// "Tu sitio en números" (deusrex#2351). Unset on a template-author build,
// where the constants are still placeholders.
const statsUrl = PUBLIC_API_BASE_URL.startsWith('http')
  ? `${PUBLIC_API_BASE_URL}/public/site-stats/${encodeURIComponent(ORG_SLUG)}`
  : '';
---

<!doctype html>
<html lang={website.language || 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {website.ogImageUrl && <meta property="og:image" content={website.ogImageUrl} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {/* SEO keywords */}
    {website.seoKeywords && <meta name="keywords" content={website.seoKeywords} />}

    {/* Favicon */}
    {website.faviconUrl
      ? <link rel="icon" href={website.faviconUrl} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    }

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?family=${fontFamily.replace(/\s+/g, '+')}:wght@300;400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    {headingFontFamily !== fontFamily && (
      <link
        href={`https://fonts.googleapis.com/css2?family=${headingFontFamily.replace(/\s+/g, '+')}:wght@300;400;500;600;700&display=swap`}
        rel="stylesheet"
      />
    )}

    {/* Design system CSS variables */}
    <style define:vars={{
      'brand-primary': designSystem?.primaryColor || business.primaryColor || '#0f172a',
      'brand-secondary': designSystem?.secondaryColor || business.secondaryColor || '#0f172a',
      'brand-accent': designSystem?.accentColor || designSystem?.primaryColor || business.primaryColor || '#0f172a',
      'brand-bg': designSystem?.backgroundColor || '#ffffff',
      'brand-surface': designSystem?.surfaceColor || '#f8fafc',
      'brand-text': designSystem?.textColor || '#0f172a',
      'brand-text-muted': designSystem?.mutedTextColor || '#64748b',
      'brand-radius': designSystem?.borderRadius || '0.5rem',
      'brand-font': `'${fontFamily}', sans-serif`,
      'brand-heading-font': `'${headingFontFamily}', sans-serif`,
    }}></style>

    {/* JSON-LD structured data — injected at build time */}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {/* A page's own head tags (a guide's Article JSON-LD, deusrex#2352). */}
    <slot name="head" />
  </head>
  <body>
    <slot />

    {/* Platform floating-action stack — the single owner of the bottom-right
        corner. The cart island portals its button in here; the WhatsApp anchor
        (AI footer) and the chat bubble (injected widget) are re-parented into
        it by the adoption script below, so the three never collide. */}
    <div id="sc-fab-stack" class="sc-fab-stack" aria-label="Quick actions"></div>

    {/* Chat widget */}
    {website.showChat && website.chatWidgetUrl && (
      <script src={website.chatWidgetUrl} data-widget-key={business.orgSlug} defer></script>
    )}

    {/* Site numbers for the clinic (deusrex#2351): a page view, the first
        visit of the day, and taps on booking, WhatsApp and call. Counts only:
        no cookie, no identifier, nothing about the visitor is sent. */}
    {statsUrl && (
      <script is:inline define:vars={{ statsUrl }}>
        (function () {
          if (!navigator.sendBeacon) return;
          function send(event) {
            try {
              navigator.sendBeacon(statsUrl + '?e=' + event);
            } catch (e) {}
          }
          send('view');
          try {
            var today = new Date().toDateString();
            if (localStorage.getItem('sc-visit-day') !== today) {
              localStorage.setItem('sc-visit-day', today);
              send('visitor');
            }
          } catch (e) {}
          document.addEventListener(
            'click',
            function (event) {
              var link = event.target && event.target.closest && event.target.closest('a[href]');
              if (!link) return;
              var href = link.getAttribute('href') || '';
              if (/wa\.me\/|api\.whatsapp\.com/.test(href)) send('whatsapp_click');
              else if (/^tel:/.test(href)) send('call_click');
              else if (/(^|\/)book(\/|\.html|\?|#|$)/.test(href)) send('booking_click');
            },
            true,
          );
        })();
      </script>
    )}

    {/* Adopt non-React floating actions into the FAB stack. The cart button is
        placed via a React portal; this only handles the WhatsApp anchor and any
        late-injected chat bubble (convention: .sc-chat-fab). */}
    <script is:inline>
      (function () {
        var stack = document.getElementById('sc-fab-stack');
        if (!stack) return;
        function adopt(el, cls) {
          if (!el || el.parentElement === stack) return;
          el.classList.add('sc-fab');
          if (cls) el.classList.add(cls);
          stack.appendChild(el);
        }
        function scan() {
          document
            .querySelectorAll('a.sc-whatsapp-fab, a[href*="wa.me"]')
            .forEach(function (a) {
              var href = (a.getAttribute('href') || '').trim();
              // Drop dead links with no phone number (e.g. "https://wa.me/").
              if (/wa\.me\/?$/.test(href)) {
                a.remove();
                return;
              }
              adopt(a, 'sc-fab--whatsapp');
            });
          document.querySelectorAll('.sc-chat-fab').forEach(function (c) {
            adopt(c, null);
          });
        }
        scan();
        // Chat widgets inject themselves after load — keep adopting late arrivals.
        new MutationObserver(scan).observe(document.body, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
  </body>
</html>
